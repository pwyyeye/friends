# 应用
NODE_ENV=development
PORT=3000
APP_NAME=friends-backend

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# MySQL
DATABASE_URL=mysql://root:root123@localhost:3306/friends?charset=utf8mb4&timezone=UTC

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=please-change-me-to-a-random-32-char-secret
JWT_EXPIRES_IN=7d

# 阿里云 OSS
OSS_PROVIDER=aliyun
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=friends-dev
OSS_PUBLIC_BASE=https://friends-dev.oss-cn-hangzhou.aliyuncs.com

# 限流
THROTTLE_TTL=60
THROTTLE_LIMIT=10