// Prisma Schema - Friends 牵线交友平台
// 详细字段说明见 docs/README.md 第六章

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============== 字典表 ==============

model City {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  pinyin    String?  @db.VarChar(50)
  province  String?  @db.VarChar(50)
  level     Int      @default(4) // 1一线 2新一线 3二线 4其他
  status    Int      @default(1) // 1启用 0禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cities")
}

model Occupation {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  category  String?  @db.VarChar(50)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("occupations")
}

model InterestTag {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(30)
  category  String?  @db.VarChar(30)
  sort      Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interest_tags")
}

// ============== 用户表 ==============

model User {
  id                BigInt            @id @default(autoincrement())
  phone             String            @unique @db.VarChar(20)
  passwordHash      String?           @db.VarChar(255)
  nickname          String?           @db.VarChar(50)
  avatarOssKey      String?           @db.VarChar(255)
  inviteCode        String?           @unique @db.VarChar(8)
  referrerId        BigInt?
  status            Int               @default(1)
  authVersion       Int               @default(0)
  cancelStatus      Int               @default(0)
  isReferrer        Boolean           @default(false)
  cancelAt          DateTime?
  termsVersion      String?           @db.VarChar(30)
  termsAcceptedAt   DateTime?
  notificationEnabled Boolean         @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  referrer          User?             @relation("Referrer", fields: [referrerId], references: [id])
  invitees          User[]            @relation("Referrer")
  childProfiles     ChildProfile[]
  matchesAsReferrer MatchRecord[]     @relation("MatchReferrer")
  referrerHistory   ReferrerHistory[] @relation("ReferrerHistoryUser")
  referredHistory   ReferrerHistory[] @relation("ReferrerHistoryNew")
  uploadedFiles     UploadedFile[]
  tokenBlacklist    TokenBlacklist[]
  profileInteractions ProfileInteraction[] @relation("InteractionActor")

  @@index([referrerId])
  @@index([status])
  @@index([isReferrer])
  @@map("users")
}

// A primary slot enforces one child today without a permanent owner uniqueness constraint.
model ChildProfile {
  id                BigInt               @id @default(autoincrement())
  ownerAccountId    BigInt
  registrationSlot  String               @unique @db.VarChar(80)
  draft             Json
  approvedPayload   Json?
  draftRevision     Int                  @default(0)
  currentStep       String?              @db.VarChar(40)
  submittedRevision Int?
  approvedRevision  Int?
  profileStatus     Int                  @default(0)
  matchmakingStatus String               @default("active") @db.VarChar(20)
  consentVersion    String?              @db.VarChar(30)
  consentAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  owner             User                 @relation(fields: [ownerAccountId], references: [id])
  reviews           UserProfilePending[]
  uploadedFiles     UploadedFile[]
  matchesAsA        MatchRecord[]        @relation("MatchProfileA")
  matchesAsB        MatchRecord[]        @relation("MatchProfileB")
  interactions      ProfileInteraction[] @relation("InteractionTarget")

  @@index([ownerAccountId])
  @@index([profileStatus])
  @@map("child_profiles")
}

// Persisted favorites, views, unlock requests and feed likes.
model ProfileInteraction {
  id              BigInt   @id @default(autoincrement())
  actorUserId     BigInt
  targetProfileId BigInt
  kind            String   @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actorUser     User         @relation("InteractionActor", fields: [actorUserId], references: [id])
  targetProfile ChildProfile @relation("InteractionTarget", fields: [targetProfileId], references: [id])

  @@unique([actorUserId, targetProfileId, kind])
  @@index([actorUserId, kind, updatedAt])
  @@index([targetProfileId, kind, updatedAt])
  @@map("profile_interactions")
}

model FeatureFlag {
  key       String   @id @db.VarChar(50)
  enabled   Boolean  @default(true)
  updatedBy BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ============== 生活照 ==============

// ============== 资料审核池 ==============

model UserProfilePending {
  id              BigInt       @id @default(autoincrement())
  profileId       BigInt
  draftRevision   Int
  consentVersion  String       @default("2026-10-06") @db.VarChar(30)
  consentAt       DateTime     @default(now())
  payloadJson     Json
  status          Int          @default(1)
  rejectReason    String?      @db.VarChar(500)
  reviewedBy      BigInt?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profile         ChildProfile @relation(fields: [profileId], references: [id])
  reviewedByAdmin Admin?       @relation(fields: [reviewedBy], references: [id])

  @@index([profileId, status])
  @@index([status])
  @@map("user_profiles_pending")
}

// ============== 牵线记录 ==============

model MatchRecord {
  id         BigInt   @id @default(autoincrement())
  profileAId BigInt
  profileBId BigInt
  referrerId BigInt?
  matchedAt  DateTime
  note       String?  @db.Text
  createdBy  BigInt
  createdAt  DateTime @default(now())

  profileA       ChildProfile @relation("MatchProfileA", fields: [profileAId], references: [id])
  profileB       ChildProfile @relation("MatchProfileB", fields: [profileBId], references: [id])
  referrer       User?        @relation("MatchReferrer", fields: [referrerId], references: [id])
  createdByAdmin Admin        @relation(fields: [createdBy], references: [id])

  @@index([referrerId])
  @@index([matchedAt])
  @@map("match_records")
}

// ============== 介绍人变更历史 ==============

model ReferrerHistory {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt
  oldReferrerId BigInt?
  newReferrerId BigInt
  reason        String?  @db.VarChar(500)
  operatedBy    BigInt
  createdAt     DateTime @default(now())

  user            User  @relation("ReferrerHistoryUser", fields: [userId], references: [id])
  newReferrer     User  @relation("ReferrerHistoryNew", fields: [newReferrerId], references: [id])
  operatedByAdmin Admin @relation(fields: [operatedBy], references: [id])

  @@index([userId])
  @@map("referrer_history")
}

// ============== 管理员 ==============

model Admin {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  role         String    @db.VarChar(20) // super_admin | operator
  status       Int       @default(1)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedProfiles UserProfilePending[]
  createdMatches   MatchRecord[]
  auditLogs        AuditLog[]
  transferOps      ReferrerHistory[]

  @@map("admins")
}

// ============== 审计日志 ==============

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  adminId     BigInt
  action      String   @db.VarChar(50)
  targetType  String   @db.VarChar(30)
  targetId    BigInt?
  payloadJson Json?
  createdAt   DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============== 上传文件记录 ==============

model UploadedFile {
  committed Boolean  @default(false)
  id        BigInt   @id @default(autoincrement())
  profileId BigInt
  userId    BigInt
  ossKey    String   @unique @db.VarChar(255)
  url       String   @db.VarChar(500)
  size      Int
  mimeType  String   @db.VarChar(50)
  purpose   String   @default("avatar") @db.VarChar(20)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  profile ChildProfile @relation(fields: [profileId], references: [id])

  @@index([userId, profileId])
  @@map("uploaded_files")
}

// ============== JWT 黑名单 ==============

model TokenBlacklist {
  jti       String   @id @db.VarChar(64)
  userId    BigInt?
  adminId   BigInt?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("token_blacklist")
}
